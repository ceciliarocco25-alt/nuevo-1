<!DOCTYPE html> 
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grupo Romano y Asociados - Soluciones Legales, Societarias y Administrativas</title>
    <link rel="canonical" href="https://www.gruporomanoasociados.com.ar">
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        navy: {
                            800: '#0f172a',
                            900: '#0b1120',
                            950: '#050811',
                        },
                        gold: {
                            400: '#fbbf24',
                            500: '#d97706',
                            600: '#b45309',
                        },
                        corporate: {
                            blue: '#1e3a8a',
                            gold: '#c5a059',
                            slate: '#334155',
                            light: '#f8fafc'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        serif: ['Cinzel', 'serif']
                    }
                }
            }
        }
    </script>
    <style>
        .gold-gradient-text {
            background: linear-gradient(135deg, #f6d365 0%, #fda085 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .hero-bg {
            background: linear-gradient(135deg, rgba(11, 17, 32, 0.94) 0%, rgba(15, 23, 42, 0.88) 100%), 
                        url('https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;
        }
    </style>
</head>
<body class="bg-corporate-light font-sans text-slate-800 antialiased selection:bg-corporate-gold selection:text-white">

    <!-- Top info bar -->
    <div class="bg-navy-950 text-slate-300 text-xs py-2 px-4 sm:px-8 border-b border-slate-800">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2">
            <div class="flex items-center gap-6">
                <span class="flex items-center gap-2"><i class="fa-solid fa-phone text-corporate-gold"></i> +54 (223) 423-7303</span>
                <span class="hidden md:flex items-center gap-2"><i class="fa-solid fa-envelope text-corporate-gold"></i> gruporomanoasociados@gmail.com</span>
                <span class="hidden xl:flex items-center gap-2"><i class="fa-solid fa-globe text-corporate-gold"></i> www.gruporomanoasociados.com.ar</span>
                <span class="hidden lg:flex items-center gap-2"><i class="fa-solid fa-clock text-corporate-gold"></i> Lun a Vie: 9:00 - 18:00 hs</span>
            </div>
            <div class="flex items-center gap-4">
                <a href="#seguimiento" class="hover:text-corporate-gold transition-colors flex items-center gap-1 font-medium">
                    <i class="fa-solid fa-magnifying-glass"></i> Consultar Estado de Trámite
                </a>
            </div>
        </div>
    </div>

    <!-- Main Header / Navbar -->
    <header class="sticky top-0 z-50 bg-navy-900/95 backdrop-blur-md text-white shadow-xl border-b border-amber-900/20">
        <div class="max-w-7xl mx-auto px-4 sm:px-8 py-4 flex justify-between items-center">
            <!-- Brand Logo -->
            <a href="#" class="flex items-center gap-3 group">
                <img src="1001080546.png" alt="Grupo Romano y Asociados Logo" class="w-12 h-12 rounded-full object-cover border border-amber-500/40 shadow-md group-hover:scale-105 transition-transform" onerror="this.onerror=null;this.src='https://placehold.co/100x100/0b1120/c5a059?text=GR';">
                <div>
                    <span class="font-serif font-bold text-xl tracking-wider block text-white group-hover:text-amber-400 transition-colors">GRUPO ROMANO</span>
                    <span class="text-[10px] tracking-[0.25em] text-amber-500 uppercase block -mt-1 font-semibold">& Asociados</span>
                </div>
            </a>

            <!-- Desktop Menu -->
            <nav class="hidden lg:flex items-center gap-8 text-sm font-medium">
                <a href="#inicio" class="hover:text-amber-400 transition-colors">Inicio</a>
                <a href="#servicios" class="hover:text-amber-400 transition-colors">Áreas de Práctica</a>
                <a href="#consulta-virtual" class="text-amber-400 hover:text-amber-300 font-semibold flex items-center gap-1.5"><i class="fa-solid fa-file-signature text-xs"></i> Consulta Paga (Virtual / Presencial)</a>
                <a href="#seguimiento" class="hover:text-amber-400 transition-colors">Seguimiento</a>
                <a href="#nosotros" class="hover:text-amber-400 transition-colors">Nosotros</a>
                <a href="#cotizador" class="hover:text-amber-400 transition-colors">Cotizador</a>
                <a href="#contacto" class="hover:text-amber-400 transition-colors">Contacto</a>
            </nav>

            <!-- Actions CTA -->
            <div class="hidden sm:flex items-center gap-3">
                <button onclick="openModal('modalConsultaPaga')" class="bg-gradient-to-r from-emerald-600 to-teal-700 hover:from-emerald-500 hover:to-teal-600 text-white font-semibold px-4 py-2 rounded-lg text-xs shadow-lg shadow-emerald-950/30 transition-all hover:scale-105 flex items-center gap-1.5 border border-emerald-400/30">
                    <i class="fa-solid fa-lock text-amber-300"></i>
                    <span>Consulta Paga (Virtual/Presencial)</span>
                </button>
                <button onclick="openModal('modalTurno')" class="bg-gradient-to-r from-amber-600 to-amber-700 hover:from-amber-500 hover:to-amber-600 text-white font-semibold px-4 py-2 rounded-lg text-xs shadow-lg shadow-amber-900/30 transition-all hover:scale-105 flex items-center gap-2">
                    <i class="fa-regular fa-calendar-check"></i>
                    <span>Turno</span>
                </button>
            </div>

            <!-- Mobile Menu Toggle -->
            <button id="mobileMenuBtn" onclick="toggleMobileMenu()" class="lg:hidden text-2xl text-slate-200 hover:text-white focus:outline-none p-1">
                <i class="fa-solid fa-bars" id="menuIcon"></i>
            </button>
        </div>

        <!-- Mobile Drawer -->
        <div id="mobileMenu" class="hidden lg:hidden bg-navy-950 border-b border-slate-800 px-6 py-5 flex flex-col gap-4 text-sm font-medium">
            <a href="#inicio" onclick="toggleMobileMenu()" class="py-2 hover:text-amber-400 border-b border-slate-800">Inicio</a>
            <a href="#servicios" onclick="toggleMobileMenu()" class="py-2 hover:text-amber-400 border-b border-slate-800">Áreas de Práctica</a>
            <a href="#consulta-virtual" onclick="toggleMobileMenu()" class="py-2 text-amber-400 font-semibold border-b border-slate-800 flex items-center gap-2">
                <i class="fa-solid fa-shield-halved"></i> Consulta Paga Virtual o Presencial (Dictamen Escrito)
            </a>
            <a href="#seguimiento" onclick="toggleMobileMenu()" class="py-2 hover:text-amber-400 border-b border-slate-800">Seguimiento de Trámite</a>
            <a href="#nosotros" onclick="toggleMobileMenu()" class="py-2 hover:text-amber-400 border-b border-slate-800">Nosotros</a>
            <a href="#cotizador" onclick="toggleMobileMenu()" class="py-2 hover:text-amber-400 border-b border-slate-800">Cotizador / Consulta</a>
            <a href="#contacto" onclick="toggleMobileMenu()" class="py-2 hover:text-amber-400">Contacto</a>
            <button onclick="toggleMobileMenu(); openModal('modalConsultaPaga')" class="w-full mt-2 bg-emerald-600 text-white font-semibold py-3 rounded-lg flex justify-center items-center gap-2">
                <i class="fa-solid fa-lock"></i> Solicitar Consulta Paga (Virtual o Presencial)
            </button>
        </div>
    </header>

    <!-- Hero Section -->
    <section id="inicio" class="hero-bg text-white relative py-20 lg:py-32 px-4 sm:px-8 overflow-hidden">
        <div class="max-w-7xl mx-auto grid lg:grid-cols-12 gap-12 items-center relative z-10">
            <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-semibold tracking-wide uppercase">
                    <i class="fa-solid fa-shield-halved"></i> Dr. Romano Pablo Martín | Dr. Grassi Luis Guillermo | Rocco Cecilia (Gestora y Mandataria)
                </div>
                <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold leading-tight">
                    Excelencia y Agilidad en sus <span class="text-amber-400 underline decoration-amber-600/50">Trámites Integrales</span>
                </h1>
                <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto lg:mx-0 font-light leading-relaxed">
                    Especialistas en <strong>Gestoría Judicial, Societaria, Automotor, Regularización Dominial y Consultoría Estratégica</strong>. Brindamos respuestas precisas y acompañamiento personalizado para empresas, profesionales y particulares.
                </p>
                <div class="pt-4 flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
                    <a href="#servicios" class="bg-amber-600 hover:bg-amber-500 text-white font-semibold px-7 py-3.5 rounded-lg shadow-lg hover:shadow-amber-600/20 transition-all flex items-center justify-center gap-2 text-center">
                        Ver Servicios <i class="fa-solid fa-arrow-right text-xs"></i>
                    </a>
                    <button onclick="openModal('modalConsultaPaga')" class="bg-gradient-to-r from-emerald-700 to-teal-800 hover:from-emerald-600 hover:to-teal-700 border border-emerald-500/40 text-white font-semibold px-7 py-3.5 rounded-lg transition-all flex items-center justify-center gap-2 text-center shadow-lg shadow-emerald-950/40">
                        <i class="fa-solid fa-file-shield text-amber-300"></i> Consulta Paga Virtual / Presencial
                    </button>
                </div>
                
                <!-- Trust Stats -->
                <div class="pt-10 grid grid-cols-3 gap-4 border-t border-slate-800/80 max-w-lg mx-auto lg:mx-0">
                    <div>
                        <p class="font-serif font-bold text-2xl sm:text-3xl text-amber-400">+25</p>
                        <p class="text-xs text-slate-400">Años de Trayectoria</p>
                    </div>
                    <div>
                        <p class="font-serif font-bold text-2xl sm:text-3xl text-amber-400">+12k</p>
                        <p class="text-xs text-slate-400">Trámites Exitosos</p>
                    </div>
                    <div>
                        <p class="font-serif font-bold text-2xl sm:text-3xl text-amber-400">99%</p>
                        <p class="text-xs text-slate-400">Satisfacción Clientes</p>
                    </div>
                </div>
            </div>

            <!-- Quick Inquiry Card -->
            <div class="lg:col-span-5">
                <div class="bg-navy-900/90 backdrop-blur-md p-6 sm:p-8 rounded-2xl border border-amber-500/20 shadow-2xl">
                    <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-4">
                        <h3 class="font-serif font-bold text-lg text-white flex items-center gap-2">
                            <i class="fa-solid fa-bolt text-amber-400"></i> Asesoramiento Inmediato
                        </h3>
                        <span class="text-xs bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 px-2.5 py-1 rounded-full font-medium">En Línea</span>
                    </div>

                    <!-- Costo de Consulta -->
                    <div class="mb-5 p-3.5 bg-slate-950/90 border border-amber-500/30 rounded-xl space-y-2 text-xs">
                        <div class="flex items-center justify-between pb-2 border-b border-slate-800/80">
                            <div class="flex items-center gap-2">
                                <i class="fa-solid fa-user-check text-amber-400"></i>
                                <span class="text-slate-200 font-semibold">Consulta Presencial / Virtual:</span>
                            </div>
                            <span class="font-bold text-amber-400 text-sm">$ 55.000 ARS</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <i class="fa-solid fa-file-signature text-emerald-400"></i>
                                <span class="text-slate-200 font-semibold">Consulta + Informe Escrito:</span>
                            </div>
                            <span class="font-bold text-emerald-400 text-sm">$ 100.000 ARS</span>
                        </div>
                    </div>

                    <form id="heroQuickForm" onsubmit="handleQuickFormSubmit(event)" class="space-y-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Nombre Completo</label>
                            <input type="text" id="hero_name" required placeholder="Ej. Carlos Mendoza" class="w-full bg-slate-950/70 border border-slate-700 rounded-lg px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 transition-colors">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Teléfono / WhatsApp</label>
                            <input type="tel" id="hero_phone" required placeholder="Ej. 11 5555 4444" class="w-full bg-slate-950/70 border border-slate-700 rounded-lg px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 transition-colors">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Área del Trámite</label>
                            <select id="hero_area" required class="w-full bg-slate-950/70 border border-slate-700 rounded-lg px-4 py-2.5 text-sm text-slate-300 focus:outline-none focus:border-amber-500 transition-colors">
                                <option value="">Seleccione una opción...</option>
                                <option value="Trámites Judiciales (Civil / Comercial / Laboral)">Trámites Judiciales (Civil / Comercial / Laboral)</option>
                                <option value="Concursos y Quiebras">Concursos y Quiebras</option>
                                <option value="Trámites Judicial Penal">Trámites Judicial Penal</option>
                                <option value="Trámites Societarios">Trámites Societarios</option>
                                <option value="Trámites Automotor">Trámites Automotor</option>
                                <option value="Regularización Dominial">Regularización Dominial</option>
                                <option value="Consultoría General y Habilitaciones">Consultoría General y Habilitaciones Comerciales</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Detalle de la consulta</label>
                            <textarea id="hero_details" rows="2" required placeholder="Describa brevemente su necesidad..." class="w-full bg-slate-950/70 border border-slate-700 rounded-lg px-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 transition-colors"></textarea>
                        </div>
                        <button type="submit" class="w-full bg-gradient-to-r from-emerald-600 to-teal-700 hover:from-emerald-500 hover:to-teal-600 text-white font-bold py-3 rounded-lg shadow-md transition-all flex justify-center items-center gap-2">
                            <span>Enviar por WhatsApp</span>
                            <i class="fa-brands fa-whatsapp text-base"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Interactive Tracking Section -->
    <section id="seguimiento" class="py-16 bg-navy-900 text-white border-y border-amber-900/30">
        <div class="max-w-7xl mx-auto px-4 sm:px-8">
            <div class="max-w-3xl mx-auto text-center space-y-4">
                <span class="text-amber-400 font-semibold text-xs tracking-widest uppercase"><i class="fa-solid fa-clock-rotate-left"></i> Transparencia y Control</span>
                <h2 class="font-serif text-2xl sm:text-4xl font-bold">Portal de Seguimiento de Trámite</h2>
                <p class="text-slate-300 text-sm sm:text-base">Ingrese su código de seguimiento asignado para verificar el estado de su trámite en tiempo real.</p>
                
                <!-- Search bar -->
                <div class="mt-8 flex flex-col sm:flex-row gap-2 max-w-xl mx-auto">
                    <div class="relative flex-grow">
                        <i class="fa-solid fa-hashtag absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <input id="trackingInput" type="text" placeholder="Ej: GR-2026-8942 ó AUTO-78" class="w-full bg-slate-950 border border-slate-700 rounded-lg sm:rounded-r-none pl-11 pr-4 py-3.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-500">
                    </div>
                    <button onclick="simularSeguimiento()" class="bg-amber-600 hover:bg-amber-500 text-white font-semibold px-6 py-3.5 rounded-lg sm:rounded-l-none transition-colors flex items-center justify-center gap-2 shrink-0">
                        <i class="fa-solid fa-magnifying-glass"></i> Consultar
                    </button>
                </div>
                <p class="text-xs text-slate-400">¿Códigos de muestra para probar? Utilice <button onclick="setTrackingDemo('GR-2026-8942')" class="text-amber-400 underline">GR-2026-8942</button> o <button onclick="setTrackingDemo('SOC-2026-1102')" class="text-amber-400 underline">SOC-2026-1102</button></p>
            </div>

            <!-- Result Box (Hidden by default) -->
            <div id="trackingResult" class="hidden max-w-3xl mx-auto mt-8 bg-slate-950 rounded-xl p-6 border border-slate-800 shadow-xl">
                <div id="trackingContent"></div>
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section id="servicios" class="py-20 px-4 sm:px-8 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
            <span class="text-amber-600 font-semibold text-xs tracking-widest uppercase"><i class="fa-solid fa-briefcase"></i> Nuestras Especialidades</span>
            <h2 class="font-serif text-3xl sm:text-4xl font-bold text-navy-900">Soluciones Integrales para Cada Necesidad</h2>
            <p class="text-slate-600 text-sm sm:text-base">Abordamos cada gestión con celeridad, seguridad jurídica y rigor profesional en los principales organismos nacionales y provinciales.</p>
        </div>

        <!-- Services Cards Grid -->
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            
            <!-- Service 1: Trámites Judicial Penal -->
            <div class="bg-white rounded-2xl p-8 border border-slate-200/80 shadow-sm hover:shadow-xl transition-all duration-300 group flex flex-col justify-between hover:-translate-y-1">
                <div>
                    <div class="w-14 h-14 bg-amber-500/10 text-amber-600 rounded-xl flex items-center justify-center text-2xl mb-6 group-hover:bg-amber-600 group-hover:text-white transition-colors">
                        <i class="fa-solid fa-handcuffs"></i>
                    </div>
                    <h3 class="font-serif font-bold text-xl text-navy-900 mb-3 group-hover:text-amber-600 transition-colors">Trámites Judicial Penal</h3>
                    <p class="text-slate-600 text-sm leading-relaxed mb-6">
                        Asistencia y diligenciamiento ante el Fuero Penal y Correccional. Presentación de escritos, vista de expedientes, exenciones de prisión, exhortos penales y antecedentes.
                    </p>
                    <ul class="space-y-2 text-xs font-medium text-slate-700 mb-8">
                        <li class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-amber-600"></i> Exhortos y Oficios en Fuero Penal</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-amber-600"></i> Vista de Causas y Escritos Urgentes</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-amber-600"></i> Certificados de Antecedentes y Reincidencia</li>
                    </ul>
                </div>
                <button onclick="solicitarServicio('Trámites Judicial Penal')" class="w-full py-2.5 px-4 rounded-lg border border-slate-300 hover:border-amber-600 hover:bg-amber-600 hover:text-white text-slate-700 text-sm font-semibold transition-all flex justify-center items-center gap-2">
                    Solicitar Información <i class="fa-solid fa-chevron-right text-xs"></i>
                </button>
            </div>

            <!-- Service 2: Trámites Judiciales -->
            <div class="bg-white rounded-2xl p-8 border border-slate-200/80 shadow-sm hover:shadow-xl transition-all duration-300 group flex flex-col justify-between hover:-translate-y-1">
                <div>
                    <div class="w-14 h-14 bg-amber-500/10 text-amber-600 rounded-xl flex items-center justify-center text-2xl mb-6 group-hover:bg-amber-600 group-hover:text-white transition-colors">
                        <i class="fa-solid fa-scale-balanced"></i>
                    </div>
                    <h3 class="font-serif font-bold text-xl text-navy-900 mb-3 group-hover:text-amber-600 transition-colors">Trámites Judiciales (Civil, Comercial y Laboral)</h3>
                    <p class="text-slate-600 text-sm leading-relaxed mb-6">
                        Diligenciamiento de cédulas, mandamientos y oficios Ley 22.172. Trámites ante Juzgados Provinciales, Federales y Cámaras de Apelación. Anotación y levantamiento de embargos e inhibiciones.
                    </p>
                    <ul class="space-y-2 text-xs font-medium text-slate-700 mb-8">
                        <li class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-amber-600"></i> Oficios Ley 22.172 y Cédulas Ley / Exhortos</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-amber-600"></i> Trámites en Fueros Civil, Comercial y Laboral</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-amber-600"></i> Inscripciones Cautelares, Embargos e Inhibiciones</li>
                    </ul>
                </div>
                <button onclick="solicitarServicio('Trámites Judiciales (Civil, Comercial y Laboral)')" class="w-full py-2.5 px-4 rounded-lg border border-slate-300 hover:border-amber-600 hover:bg-amber-600 hover:text-white text-slate-700 text-sm font-semibold transition-all flex justify-center items-center gap-2">
                    Solicitar Información <i class="fa-solid fa-chevron-right text-xs"></i>
                </button>
            </div>

            <!-- Service 3: Concursos y Quiebras -->
            <div class="bg-white rounded-2xl p-8 border border-slate-200/80 shadow-sm hover:shadow-xl transition-all duration-300 group flex flex-col justify-between hover:-translate-y-1">
                <div>
                    <div class="w-14 h-14 bg-amber-500/10 text-amber-600 rounded-xl flex items-center justify-center text-2xl mb-6 group-hover:bg-amber-600 group-hover:text-white transition-colors">
                        <i class="fa-solid fa-gavel"></i>
                    </div>
                    <h3 class="font-serif font-bold text-xl text-navy-900 mb-3 group-hover:text-amber-600 transition-colors">Concursos y Quiebras</h3>
                    <p class="text-slate-600 text-sm leading-relaxed mb-6">
                        Gestión integral en procesos de Concursos Preventivos y Quiebras. Verificación e impugnación de créditos, atención a Sindicaturas, inhibiciones generales de bienes y reestructuración de pasivos.
                    </p>
                    <ul class="space-y-2 text-xs font-medium text-slate-700 mb-8">
                        <li class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-amber-600"></i> Verificación e Impugnación de Créditos</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-amber-600"></i> Diligencias y Gestiones en Sindicaturas</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-circle-check text-amber-600"></i> Levantamiento de Inhibiciones Comercial/Bancaria</li>
                    </ul>
                </div>
                <button onclick="solicitarServicio('Concursos y Quiebras')" class="w-full py-2.5 px-4 rounded-lg border border-slate-300 hover:border-amber-600 hover:bg-amber-600 hover:text-white text-slate-700 text-sm font-semibold transition-all flex justify-center items-center gap-2">
