    <!-- Interactive Budget Estimator / Wizard Section -->
    <section id="cotizador" class="py-20 bg-slate-100 border-t border-slate-200">
        <div class="max-w-5xl mx-auto px-4 sm:px-8">
            <div class="bg-white rounded-3xl shadow-xl overflow-hidden border border-slate-200">
                <div class="bg-navy-900 text-white p-6 sm:p-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                    <div>
                        <span class="text-xs font-bold text-amber-400 uppercase tracking-widest">Herramienta Interactiva</span>
                        <h3 class="font-serif text-2xl font-bold">Simulador de Cotización y Asesoría</h3>
                    </div>
                    <span class="bg-amber-500/20 text-amber-400 border border-amber-500/30 text-xs px-3 py-1.5 rounded-full font-medium">Paso a Paso</span>
                </div>

                <div class="p-6 sm:p-10">
                    <!-- Progress Bar -->
                    <div class="mb-8">
                        <div class="flex justify-between text-xs font-semibold text-slate-500 mb-2">
                            <span id="stepLabel1" class="text-amber-600">1. Tipo de Gestión</span>
                            <span id="stepLabel2">2. Urgencia y Ubicación</span>
                            <span id="stepLabel3">3. Datos de Contacto</span>
                        </div>
                        <div class="h-2 bg-slate-100 rounded-full overflow-hidden">
                            <div id="wizardProgress" class="h-full bg-amber-600 transition-all duration-300 w-1/3"></div>
                        </div>
                    </div>

                    <!-- Wizard Form -->
                    <form id="wizardForm" onsubmit="handleWizardSubmit(event)">
                        <!-- Step 1 -->
                    <div id="step1" class="space-y-6">
                        <h4 class="font-semibold text-slate-800 text-base">Seleccione la categoría del trámite a realizar:</h4>
                        <div class="grid sm:grid-cols-2 gap-4">
                            <label class="border-2 border-slate-200 p-4 rounded-xl flex items-center gap-3 cursor-pointer hover:border-amber-500 transition-all">
                                <input type="radio" name="wiz_service" value="Trámites Judiciales" class="text-amber-600 focus:ring-amber-500" required checked>
                                <div>
                                    <p class="font-semibold text-sm text-slate-800">Trámites Judiciales (Civil / Comercial / Laboral)</p>
                                    <p class="text-xs text-slate-500">Cédulas, oficios Ley 22.172, inscripciones, embargos</p>
                                </div>
                            </label>
                            <label class="border-2 border-slate-200 p-4 rounded-xl flex items-center gap-3 cursor-pointer hover:border-amber-500 transition-all">
                                <input type="radio" name="wiz_service" value="Concursos y Quiebras" class="text-amber-600 focus:ring-amber-500">
                                <div>
                                    <p class="font-semibold text-sm text-slate-800">Concursos y Quiebras</p>
                                    <p class="text-xs text-slate-500">Verificación de créditos, fuero comercial, inhibiciones</p>
                                </div>
                            </label>
                            <label class="border-2 border-slate-200 p-4 rounded-xl flex items-center gap-3 cursor-pointer hover:border-amber-500 transition-all">
                                <input type="radio" name="wiz_service" value="Trámites Judicial Penal" class="text-amber-600 focus:ring-amber-500">
                                <div>
                                    <p class="font-semibold text-sm text-slate-800">Trámites Judicial Penal</p>
                                    <p class="text-xs text-slate-500">Fuero penal, exhortos, antecedentes, escritos</p>
                                </div>
                            </label>
                            <label class="border-2 border-slate-200 p-4 rounded-xl flex items-center gap-3 cursor-pointer hover:border-amber-500 transition-all">
                                <input type="radio" name="wiz_service" value="Trámites Societarios" class="text-amber-600 focus:ring-amber-500">
                                <div>
                                    <p class="font-semibold text-sm text-slate-800">Trámites Societarios</p>
                                    <p class="text-xs text-slate-500">Constitución SAS/SRL, IGJ, Libros</p>
                                </div>
                            </label>
                            <label class="border-2 border-slate-200 p-4 rounded-xl flex items-center gap-3 cursor-pointer hover:border-amber-500 transition-all">
                                <input type="radio" name="wiz_service" value="Trámites Automotor" class="text-amber-600 focus:ring-amber-500">
                                <div>
                                    <p class="font-semibold text-sm text-slate-800">Trámites Automotor</p>
                                    <p class="text-xs text-slate-500">Transferencias, bajas, prendas, dominios</p>
                                </div>
                            </label>
                            <label class="border-2 border-slate-200 p-4 rounded-xl flex items-center gap-3 cursor-pointer hover:border-amber-500 transition-all">
                                <input type="radio" name="wiz_service" value="Regularización Dominial" class="text-amber-600 focus:ring-amber-500">
                                <div>
                                    <p class="font-semibold text-sm text-slate-800">Regularización Dominial</p>
                                    <p class="text-xs text-slate-500">Usucapión, escrituras, posesiones</p>
                                </div>
                            </label>
                            <label class="border-2 border-slate-200 p-4 rounded-xl sm:col-span-2 flex items-center gap-3 cursor-pointer hover:border-amber-500 transition-all bg-amber-50/50 border-amber-200">
                                <input type="radio" name="wiz_service" value="Consulta Legal Presencial / Virtual ($55.000 ARS o $100.000 c/ Informe)" class="text-amber-600 focus:ring-amber-500">
                                <div>
                                    <div class="flex items-center gap-2">
                                        <p class="font-bold text-sm text-slate-900">Consulta Legal Paga (Presencial o Virtual)</p>
                                        <span class="bg-emerald-600 text-white text-[10px] font-bold px-2 py-0.5 rounded">$55k / $100k</span>
                                    </div>
                                    <p class="text-xs text-slate-600">Reunión presencial o videoconferencia de 45 min ($55.000 ARS) o con Dictamen e Informe Escrito ($100.000 ARS).</p>
                                </div>
                            </label>
                            <label class="border-2 border-slate-200 p-4 rounded-xl sm:col-span-2 flex items-center gap-3 cursor-pointer hover:border-amber-500 transition-all">
                                <input type="radio" name="wiz_service" value="Consultoría General y Habilitaciones Comerciales" class="text-amber-600 focus:ring-amber-500">
                                <div>
                                    <p class="font-semibold text-sm text-slate-800">Consultoría General y Habilitaciones Comerciales</p>
                                    <p class="text-xs text-slate-500">Habilitaciones municipales, asesoramiento preventivo, dictámenes y contratos</p>
                                </div>
                            </label>
                        </div>
                        <div class="flex justify-end pt-4">
                            <button type="button" onclick="goToStep(2)" class="bg-amber-600 hover:bg-amber-500 text-white font-semibold px-6 py-2.5 rounded-lg text-sm transition-colors flex items-center gap-2">
                                Siguiente <i class="fa-solid fa-arrow-right text-xs"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Step 2 -->
                    <div id="step2" class="space-y-6 hidden">
                        <h4 class="font-semibold text-slate-800 text-base">Urgencia y Jurisdicción del Trámite:</h4>
                        <div class="grid sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 uppercase mb-2">Plazo de Urgencia</label>
                                <select name="wiz_urgency" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-3 text-sm text-slate-800 focus:outline-none focus:border-amber-500">
                                    <option value="Normal (Plazo estándar)">Normal (Plazo estándar de gestión)</option>
                                    <option value="Urgente (48 hs)">Urgente (Prioridad 48 hs)</option>
                                    <option value="Muy Urgente / Medida Cautelar (24 hs)">Muy Urgente / Medida Cautelar (24 hs)</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 uppercase mb-2">Jurisdicción / Ubicación</label>
                                <select name="wiz_location" class="w-full bg-slate-50 border border-slate-300 rounded-lg p-3 text-sm text-slate-800 focus:outline-none focus:border-amber-500">
                                    <option value="Mar del Plata y Zona">Mar del Plata / Costa Atlántica</option>
                                    <option value="Provincia de Buenos Aires">Provincia de Buenos Aires (Deptos. Judiciales)</option>
                                    <option value="CABA / IGJ">CABA / Ciudad Autónoma de Buenos Aires</option>
                                    <option value="Nacional / Otra Provincia">Nacional / Otra Provincia</option>
                                </select>
                            </div>
                        </div>
                        <div class="flex justify-between pt-4">
                            <button type="button" onclick="goToStep(1)" class="bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold px-6 py-2.5 rounded-lg text-sm transition-colors flex items-center gap-2">
                                <i class="fa-solid fa-arrow-left text-xs"></i> Anterior
                            </button>
                            <button type="button" onclick="goToStep(3)" class="bg-amber-600 hover:bg-amber-500 text-white font-semibold px-6 py-2.5 rounded-lg text-sm transition-colors flex items-center gap-2">
                                Siguiente <i class="fa-solid fa-arrow-right text-xs"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Step 3 -->
                    <div id="step3" class="space-y-6 hidden">
                        <h4 class="font-semibold text-slate-800 text-base">Datos de contacto para enviar la estimación:</h4>
                        <div class="grid sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 uppercase mb-1">Nombre Completo *</label>
                                <input type="text" id="wiz_name" required placeholder="Ej. Roberto Gómez" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-4 py-2.5 text-sm text-slate-800 focus:outline-none focus:border-amber-500">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 uppercase mb-1">Teléfono / WhatsApp *</label>
                                <input type="tel" id="wiz_phone" required placeholder="Ej. +54 9 223 555-4433" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-4 py-2.5 text-sm text-slate-800 focus:outline-none focus:border-amber-500">
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 uppercase mb-1">Observación adicional (Opcional)</label>
                            <textarea id="wiz_notes" rows="2" placeholder="Describa detalles o número de autos si posee..." class="w-full bg-slate-50 border border-slate-300 rounded-lg px-4 py-2.5 text-sm text-slate-800 focus:outline-none focus:border-amber-500"></textarea>
                        </div>
                        <div class="flex justify-between pt-4">
                            <button type="button" onclick="goToStep(2)" class="bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold px-6 py-2.5 rounded-lg text-sm transition-colors flex items-center gap-2">
                                <i class="fa-solid fa-arrow-left text-xs"></i> Anterior
                            </button>
                            <button type="submit" class="bg-gradient-to-r from-amber-600 to-amber-700 hover:from-amber-500 hover:to-amber-600 text-white font-bold px-8 py-2.5 rounded-lg text-sm shadow-md transition-all flex items-center gap-2">
                                <i class="fa-solid fa-paper-plane text-xs"></i>
                                <span>Solicitar Estimación</span>
                            </button>
                        </div>
                    </div>
                    </form>

                    <!-- Trust Cards below form -->
                    <div class="grid sm:grid-cols-3 gap-4 mt-8 pt-8 border-t border-slate-200">
