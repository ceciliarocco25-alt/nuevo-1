                        <div class="w-10 h-10 rounded-full bg-amber-600/30 text-amber-400 font-bold flex items-center justify-center text-sm">EB</div>
                        <div>
                            <p class="font-semibold text-xs text-white">Eduardo Benítez</p>
                            <p class="text-[10px] text-slate-400">Gerente de Logística</p>
                        </div>
