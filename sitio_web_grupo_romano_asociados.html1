                        <option value="Regularización Dominial / Usucapión">Regularización Dominial (Propiedades, Usucapión, Mensuras)</option>
                        <option value="Derecho Automotor / Dominios">Gestoría Automotor (Transferencias Complejas, Prendas)</option>
                        <option value="Consultoría Patrimonial / Habilitaciones">Consultoría General, Habilitaciones Comerciales y Estrategia Legal</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Detalle de la Consulta *</label>
                    <textarea id="paid_details" rows="3" required placeholder="Sintetice los hechos, antecedentes e inquietudes concretas que desea tratar en la consulta..." class="w-full bg-slate-50 border border-slate-300 rounded-lg px-3.5 py-2.5 text-sm focus:outline-none focus:border-amber-500"></textarea>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Adjuntar Documentación Relevante (Opcional - Máx. 15 págs)</label>
                    <div class="border-2 border-dashed border-slate-300 rounded-xl p-4 text-center bg-slate-50 hover:border-amber-500 transition-colors">
                        <i class="fa-solid fa-cloud-arrow-up text-2xl text-slate-400 mb-1"></i>
                        <p class="text-xs text-slate-600 font-medium">Haga clic o arrastre archivos PDF, imágenes o escrituras aquí</p>
                        <p class="text-[10px] text-slate-400 mt-0.5">Formatos permitidos: PDF, JPG, PNG, DOCX (Cifrado local)</p>
                        <input type="file" multiple class="hidden" id="paid_files" onchange="showSelectedFiles(this)">
                        <button type="button" onclick="document.getElementById('paid_files').click()" class="mt-2 text-xs bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold px-3 py-1.5 rounded-lg transition-colors">
                            Seleccionar Archivos
                        </button>
                        <div id="fileListNames" class="mt-2 text-xs font-medium text-emerald-600"></div>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Método de Pago Preferido</label>
                    <div class="grid grid-cols-2 gap-3">
                        <label class="border border-slate-300 p-3 rounded-xl flex items-center gap-2 cursor-pointer hover:border-emerald-500 transition-all bg-emerald-50/40">
                            <input type="radio" name="paid_method" value="Mercado Pago" checked class="text-emerald-600 focus:ring-emerald-500">
                            <div>
                                <p class="font-bold text-xs text-slate-800"><i class="fa-solid fa-qrcode text-emerald-600"></i> Mercado Pago</p>
                                <p class="text-[10px] text-slate-500">Tarjeta, Débito o Dinero en cuenta</p>
                            </div>
                        </label>
                        <label class="border border-slate-300 p-3 rounded-xl flex items-center gap-2 cursor-pointer hover:border-amber-500 transition-all bg-amber-50/40">
                            <input type="radio" name="paid_method" value="Transferencia Bancaria" class="text-amber-600 focus:ring-amber-500">
                            <div>
                                <p class="font-bold text-xs text-slate-800"><i class="fa-solid fa-building-columns text-amber-600"></i> Transferencia CBU</p>
                                <p class="text-[10px] text-slate-500">Descuento 5% por transferencia</p>
                            </div>
                        </label>
                    </div>
                </div>

                <div class="pt-3 border-t border-slate-200 flex flex-col sm:flex-row justify-between items-center gap-4">
                    <div class="text-left">
                        <span class="text-xs text-slate-500 block">Total a Abonar:</span>
                        <span id="consultationTotalPriceDisplay" class="text-2xl font-bold font-serif text-navy-900">$ 55.000 ARS</span>
                    </div>
                    <button type="submit" class="w-full sm:w-auto bg-gradient-to-r from-emerald-600 to-teal-700 hover:from-emerald-500 hover:to-teal-600 text-white font-bold px-8 py-3.5 rounded-xl shadow-xl transition-all flex items-center justify-center gap-2">
                        <i class="fa-solid fa-lock"></i>
                        <span>Confirmar & Abonar Consulta</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Toast Notification Element -->
    <div id="toastNotification" class="fixed top-5 right-5 z-50 hidden bg-emerald-700 text-white px-5 py-3 rounded-xl shadow-2xl flex items-center gap-3 transition-all transform duration-300">
        <i class="fa-solid fa-circle-check text-xl text-emerald-300"></i>
        <span id="toastMessage" class="text-sm font-medium"></span>
    </div>

    <script>
        // Toggle Mobile Menu
        function toggleMobileMenu() {
            const menu = document.getElementById('mobileMenu');
            const icon = document.getElementById('menuIcon');
            if (menu.classList.contains('hidden')) {
                menu.classList.remove('hidden');
                icon.classList.remove('fa-bars');
                icon.classList.add('fa-xmark');
            } else {
                menu.classList.add('hidden');
                icon.classList.remove('fa-xmark');
                icon.classList.add('fa-bars');
            }
        }

        // Modal Controls
        function openModal(modalId, presetOption) {
            const modal = document.getElementById(modalId);
            if (modal) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            }

            if (modalId === 'modalConsultaPaga' && presetOption) {
                if (presetOption === 'dictamen') {
                    const dictamenRadio = document.getElementById('paid_type_dictamen');
                    if (dictamenRadio) {
                        dictamenRadio.checked = true;
                        updateConsultationPrice('100000');
                    }
                } else {
                    const simpleRadio = document.getElementById('paid_type_simple');
                    if (simpleRadio) {
                        simpleRadio.checked = true;
                        updateConsultationPrice('55000');
                    }
                }
            }
        }

        function updateConsultationPrice(amount) {
            const display = document.getElementById('consultationTotalPriceDisplay');
            if (display) {
                if (amount === '100000') {
                    display.innerText = '$ 100.000 ARS';
                } else {
                    display.innerText = '$ 55.000 ARS';
                }
            }
        }

        function closeModal(modalId) {
            const modal = document.getElementById(modalId);
            if (modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
        }

        // File Selection Feedback
        function showSelectedFiles(input) {
            const list = document.getElementById('fileListNames');
            if (input.files && input.files.length > 0) {
                let names = Array.from(input.files).map(f => f.name).join(', ');
                list.innerText = `Archivos seleccionados (${input.files.length}): ${names}`;
            } else {
                list.innerText = '';
            }
        }

        function solicitarServicio(nombreServicio) {
            const titleEl = document.getElementById('modalConsultaTitle');
            const fieldEl = document.getElementById('modalServiceField');
            if (titleEl) titleEl.innerText = 'Consulta: ' + nombreServicio;
            if (fieldEl) fieldEl.value = nombreServicio;
            openModal('modalConsulta');
        }

        // Paid Consultation Form Submit Handler
        function handlePaidConsultSubmit(e) {
            e.preventDefault();
            const name = document.getElementById('paid_name').value;
            const email = document.getElementById('paid_email').value;
            showToast(`¡Solicitud registrada! Redirigiendo a pasarela de pago para ${name}...`);
            
            setTimeout(() => {
                showToast(`Se han enviado las instrucciones de la consulta y el comprobante NDA a ${email}.`);
            }, 3000);

            e.target.reset();
            const fileList = document.getElementById('fileListNames');
            if (fileList) fileList.innerText = '';
            closeModal('modalConsultaPaga');
        }

        // Toast Notification System
        function showToast(message) {
            const toast = document.getElementById('toastNotification');
            const toastMsg = document.getElementById('toastMessage');
            if (toast && toastMsg) {
                toastMsg.innerText = message;
                toast.classList.remove('hidden');
                setTimeout(() => {
                    toast.classList.add('hidden');
                }, 4500);
            }
        // Helper function to send message directly to WhatsApp (+54 9 223 423-7303)
        function sendToWhatsApp(messageText) {
            const phoneNumber = "5492234237303";
            const encodedMsg = encodeURIComponent(messageText);
            const waUrl = `https://wa.me/${phoneNumber}?text=${encodedMsg}`;
            window.open(waUrl, '_blank');
        }

        // Form Submit Handlers with WhatsApp integration
        function handleQuickFormSubmit(e) {
            e.preventDefault();
            const name = document.getElementById('hero_name').value;
            const phone = document.getElementById('hero_phone').value;
            const area = document.getElementById('hero_area').value;
            const details = document.getElementById('hero_details').value;

            const msg = `*Nueva Consulta Rápida - Grupo Romano & Asociados*\n\n` +
                        `👤 *Nombre:* ${name}\n` +
                        `📞 *Teléfono/WA:* ${phone}\n` +
                        `📋 *Área:* ${area}\n` +
                        `💬 *Consulta:* ${details}`;

            showToast('¡Redirigiendo a WhatsApp con su consulta!');
            sendToWhatsApp(msg);
            e.target.reset();
        }

        function handleMainContact(e) {
            e.preventDefault();
            const name = document.getElementById('contact_name').value;
            const dni = document.getElementById('contact_dni').value || 'No especificado';
            const phone = document.getElementById('contact_phone').value;
            const email = document.getElementById('contact_email').value;
            const motivo = document.getElementById('contact_motivo').value;
            const mensaje = document.getElementById('contact_mensaje').value;

            const msg = `*Contacto Institucional - Grupo Romano & Asociados*\n\n` +
                        `👤 *Nombre:* ${name}\n` +
                        `🆔 *DNI/CUIT:* ${dni}\n` +
                        `📞 *Teléfono:* ${phone}\n` +
                        `✉️ *Email:* ${email}\n` +
                        `📋 *Departamento:* ${motivo}\n` +
                        `💬 *Mensaje:* ${mensaje}`;

            showToast('¡Redirigiendo a WhatsApp...');
            sendToWhatsApp(msg);
            e.target.reset();
        }

        function handlePaidConsultSubmit(e) {
            e.preventDefault();
            const typeRadio = document.querySelector('input[name="paid_type"]:checked');
            const type = typeRadio ? typeRadio.value : 'Consulta Presencial o Virtual';
            const modalityRadio = document.querySelector('input[name="paid_modality"]:checked');
            const modality = modalityRadio ? modalityRadio.value : 'Presencial';
            const name = document.getElementById('paid_name').value;
            const dni = document.getElementById('paid_dni').value;
            const phone = document.getElementById('paid_phone').value;
            const email = document.getElementById('paid_email').value;
            const area = document.getElementById('paid_area').value;
            const details = document.getElementById('paid_details').value;
            const methodRadio = document.querySelector('input[name="paid_method"]:checked');
            const method = methodRadio ? methodRadio.value : 'Mercado Pago';

            const msg = `*Solicitud de Consulta Legal Paga - Grupo Romano & Asociados*\n\n` +
                        `⭐ *Servicio:* ${type}\n` +
                        `📍 *Modalidad:* ${modality}\n` +
                        `👤 *Cliente:* ${name}\n` +
                        `🆔 *DNI/CUIT:* ${dni}\n` +
                        `📞 *WhatsApp:* ${phone}\n` +
                        `✉️ *Email:* ${email}\n` +
                        `📋 *Área del Caso:* ${area}\n` +
                        `💳 *Método de Pago Preferido:* ${method}\n` +
                        `💬 *Detalle:* ${details}`;

            showToast('¡Iniciando solicitud vía WhatsApp!');
            sendToWhatsApp(msg);
            e.target.reset();
            const fileList = document.getElementById('fileListNames');
            if (fileList) fileList.innerText = '';
            closeModal('modalConsultaPaga');
        }

        function handleTurnoSubmit(e) {
            e.preventDefault();
            const name = document.getElementById('turno_name').value;
            const phone = document.getElementById('turno_phone').value;
            const modality = document.getElementById('turno_modality').value;
            const date = document.getElementById('turno_date').value;

            const msg = `*Solicitud de Turno - Grupo Romano & Asociados*\n\n` +
                        `👤 *Nombre:* ${name}\n` +
                        `📞 *Teléfono:* ${phone}\n` +
                        `📍 *Modalidad:* ${modality}\n` +
                        `📅 *Fecha Pretendida:* ${date}`;

            showToast('¡Redirigiendo para confirmar turno!');
            sendToWhatsApp(msg);
            e.target.reset();
            closeModal('modalTurno');
        }

        function handleServiceConsultSubmit(e) {
            e.preventDefault();
            const serviceField = document.getElementById('modalServiceField').value || 'Servicio Especializado';
            const name = document.getElementById('service_name').value;
            const phone = document.getElementById('service_phone').value;
            const details = document.getElementById('service_details').value;

            const msg = `*Consulta de Servicio: ${serviceField}*\n\n` +
                        `👤 *Nombre:* ${name}\n` +
                        `📞 *Teléfono/WA:* ${phone}\n` +
                        `💬 *Detalle:* ${details}`;

            showToast('¡Enviando consulta por WhatsApp!');
            sendToWhatsApp(msg);
            e.target.reset();
            closeModal('modalConsulta');
        }

        function handleWizardSubmit(e) {
            e.preventDefault();
            const serviceRadio = document.querySelector('input[name="wiz_service"]:checked');
            const service = serviceRadio ? serviceRadio.value : 'General';
            const urgencyEl = document.querySelector('select[name="wiz_urgency"]');
            const urgency = urgencyEl ? urgencyEl.value : 'Normal';
            const locationEl = document.querySelector('select[name="wiz_location"]');
            const location = locationEl ? locationEl.value : 'Mar del Plata';
            const name = document.getElementById('wiz_name').value;
            const phone = document.getElementById('wiz_phone').value;
            const notes = document.getElementById('wiz_notes').value || 'Sin observaciones';

            const msg = `*Cotización Estimada Paso a Paso - Grupo Romano & Asociados*\n\n` +
                        `📋 *Servicio Requerido:* ${service}\n` +
                        `⏱️ *Urgencia:* ${urgency}\n` +
                        `📍 *Ubicación/Jurisdicción:* ${location}\n` +
                        `👤 *Nombre:* ${name}\n` +
                        `📞 *Contacto:* ${phone}\n` +
                        `💬 *Observaciones:* ${notes}`;

            showToast('¡Enviando datos de cotización por WhatsApp!');
            sendToWhatsApp(msg);
            e.target.reset();
            goToStep(1);
        }

        // FAQ Toggle
        function toggleFaq(id) {
            const el = document.getElementById(id);
            const icon = document.getElementById(id + '_icon');
            if (el && icon) {
                if (el.classList.contains('hidden')) {
                    el.classList.remove('hidden');
                    icon.classList.add('rotate-180');
                } else {
                    el.classList.add('hidden');
                    icon.classList.remove('rotate-180');
                }
            }
        }
    </script>
</body>
</html>
